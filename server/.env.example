# Copy to .env and fill in. Never commit the real .env (make sure it is in .gitignore).
# Anything marked REQUIRED makes the app exit at startup if it is missing or invalid.

# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
# development | production | test
# Defaults to "production" when unset (fails safe), so set "development" for local work.
# In development, error responses include stack traces and logs are pretty-printed.
NODE_ENV=development

# Port the API listens on (default: 5000)
PORT=5000

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# REQUIRED. Must start with mongodb:// or mongodb+srv://
# Local:  mongodb://127.0.0.1:27017/contact-keeper
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/contact-keeper?retryWrites=true&w=majority
# URL-encode special characters in the password (e.g. @ becomes %40).
DATABASE_URL=mongodb://127.0.0.1:27017/contact-keeper

# ------------------------------------------------------------------
# Auth
# ------------------------------------------------------------------
# REQUIRED. Signs access tokens (JWT, HS256). At least 32 characters; use a long random value.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs every user out (existing access tokens stop verifying).
ACCESS_TOKEN_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars

# How long a login session lasts, in days (1-365, default: 7).
# It is a fixed lifetime: refreshing tokens never extends it.
SESSION_LIFETIME_DAYS=7

# ------------------------------------------------------------------
# CORS / networking
# ------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API and send the refresh cookie.
# Scheme + host (+ port) only: no path, no trailing slash. Empty (the default) blocks all
# cross-origin browser access. Postman and curl are unaffected.
# Local example (Vite):  http://localhost:5173   (Create React App uses http://localhost:3000)
# Production example:    https://your-app.netlify.app
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the app (default: 0).
# 0 when running locally. On Render start with 1, then check that the client IPs in your
# logs are real; it decides which IP the rate limiter counts.
TRUST_PROXY=0

# ------------------------------------------------------------------
# Docs and logging
# ------------------------------------------------------------------
# Serve Swagger UI at /docs. Leave unset for the default: on outside production, off in production.
# Set to true to expose the docs in production, or false to hide them everywhere.
# API_DOCS_ENABLED=true

# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info

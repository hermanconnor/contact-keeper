# Application Environment (development, production, test)
NODE_ENV=development

# Server Port
PORT=5000

# Database Connection String (MongoDB)
# DATABASE_URL=mongodb://username:password@localhost:27017/your_database_name
# MongoDB Atlas:
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/your_database_name?retryWrites=true&w=majority

# Authentication Secrets (Must be at least 10 characters)
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_here

# Application Base URL
BASE_URL=http://localhost:5000

# Logging Level (fatal, error, warn, info, debug, trace, silent)
LOG_LEVEL=info
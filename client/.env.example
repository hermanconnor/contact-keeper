# Base URL of the API, no trailing slash.
# Local dev: leave as is. Vite proxies /api to http://localhost:5000 (see vite.config.ts).
# Production: the full URL of the deployed API, e.g. https://your-api.onrender.com/api/v1
#   (then add this site's origin to CORS_ORIGINS on the API).
VITE_API_URL=/api/v1
